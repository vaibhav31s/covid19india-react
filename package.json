{
  "name": "covid19india",
  "version": "1.0.0",
  "private": true,
  "homepage": "http://covid19india.github.io/",
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "@primer/octicons-react": "^19.42.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@use-gesture/react": "^10.3.1",
    "animejs": "^4.5.0",
    "axios": "^1.21.1",
    "classnames": "^2.5.1",
    "corejs-typeahead": "^1.3.4",
    "d3": "^7.9.2",
    "d3-interpolate-path": "^2.3.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fast-deep-equal": "^3.1.3",
    "i18next": "^27.2.6",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.1.1",
    "immer": "^11.2.10",
    "intersection-observer": "^0.12.2",
    "leaflet": "^1.9.4",
    "leaflet-knn": "^0.1.0",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-calendar": "^6.0.1",
    "react-content-loader": "^7.1.2",
    "react-date-picker": "^12.1.0",
    "react-dom": "^19.3.1",
    "react-feather": "^2.0.10",
    "react-helmet": "^6.1.0",
    "react-i18next": "^18.0.3",
    "react-is-visible": "^1.2.0",
    "react-router-dom": "^7.18.6",
    "react-spring": "^10.0.4",
    "react-use": "^17.6.1",
    "source-map-explorer": "^2.5.3",
    "styled-components": "^6.6.0",
    "swr": "^2.5.1",
    "topojson": "^3.0.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && npm run compress_maps && cp build/index.html build/404.html && npm run build-sw",
    "map_test": "vitest run src/__tests__/mapAndApiStateNames.test.js",
    "compress_maps": "rollup -c",
    "test": "vitest run --exclude src/__tests__/mapAndApiStateNames.test.js",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix --max-warnings=0",
    "format": "prettier --write \"**/*.+(js|jsx|json|yml|yaml|md|html)\"",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "build-sw": "node ./src/sw-build.js",
    "start-sw": "http-server ./build -c 0",
    "preview": "vite preview"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.+(js|jsx)": [
      "npm run eslint:fix",
      "prettier --write \"**/*.+(js|jsx)\""
    ],
    "*.+(json|yml|yaml|md)": [
      "prettier --write \"**/*.+(json|yml|yaml|md)\""
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "rollup": "^4.68.8",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.108.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "corejs-typeahead": {
      "jquery": "^3.7.1"
    }
  }
}
